<?xml version="1.0" encoding="utf-8"?>
<!-- Back up your library, lists, listening spots and settings. Skip downloads and the catalog: both can be fetched again. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="library.db" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="library.db" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
